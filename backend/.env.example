# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=4000

# Security — REQUIRED: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here
JWT_EXPIRES_IN=7d

# Database (SQLite for dev, PostgreSQL URL for prod)
# SQLite (dev): leave empty — defaults to ./data/medismart.db
# PostgreSQL (prod): DATABASE_URL=postgresql://user:pass@host:5432/medismart
DATABASE_URL=

# CORS — Frontend URL
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10
